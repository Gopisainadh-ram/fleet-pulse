# Copy this file to .env before starting the project.
# Keep this file committed; do not store real secrets here.

DATABASE_URL="postgresql://fleet:fleet@localhost:5432/fleetpulse?schema=public"

# Generate unique 32+ character secrets with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_32_char_or_longer_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_32_char_or_longer_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

PORT=3333
CORS_ORIGIN=http://localhost:4200
WEB_APP_URL=http://localhost:4200

# Bootstrap super-admin for local dev
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_FIRST_NAME=Fleet
SUPER_ADMIN_LAST_NAME=Admin
SUPER_ADMIN_BOOTSTRAP_PASSWORD=ChangeMeNow123
SUPER_ADMIN_RESET_PASSWORD=false

# Optional SMTP settings for email invitations
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
