{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "importHelpers": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "paths": {
      "@fleet-pulse/shared": ["./libs/shared/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist"]
}
