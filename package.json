{
  "name": "fleet-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Fleet management platform: Angular + Express + PostgreSQL (Prisma) in an Nx monorepo",
  "scripts": {
    "start:api": "nx serve api",
    "start:web": "nx serve web",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "db:up": "docker compose up -d db",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "audit": "npm audit --omit=dev"
  },
  "prisma": {
    "schema": "apps/api/prisma/schema.prisma",
    "seed": "tsx apps/api/prisma/seed.ts"
  },
  "dependencies": {
    "@angular/common": "19.0.5",
    "@angular/compiler": "19.0.5",
    "@angular/core": "19.0.5",
    "@angular/forms": "19.0.5",
    "@angular/platform-browser": "19.0.5",
    "@angular/router": "19.0.5",
    "@prisma/client": "6.1.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.0.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "^10.3.0",
    "pino": "9.5.0",
    "pino-http": "10.3.0",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zod": "3.24.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "19.0.6",
    "@angular/cli": "19.0.6",
    "@angular/compiler-cli": "19.0.5",
    "@nx/angular": "20.3.0",
    "@nx/esbuild": "20.3.0",
    "@nx/js": "20.3.0",
    "@nx/workspace": "20.3.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.10.2",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.19.12",
    "nx": "20.3.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "prisma": "6.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
